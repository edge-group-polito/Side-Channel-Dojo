CAPI=2:
# Copyright 2024 POLITO
# Solderpad Hardware License, Version 2.1, see LICENSE.md for details.
# SPDX-License-Identifier: Apache-2.0 WITH SHL-2.1
#
# File: aes.core
# Author: Mattia Mirigaldi
# Date: 06/06/2024
# Description: AES side channel resistant implementation core file

name: "vlsi:polito:aes:0.1.0"
description: "Advanced Encryption Standard HDL with power resistant Sbox"

filesets: 
  rtl-bare:
    files:
    - rtl/AES_common/aes_ks.v
    - rtl/AES_common/Sbox/aes_sbox_comb.v
    - rtl/AES_common/Sbox/aes_sbox_lut_rijandael.v
    - rtl/AES_common/Sbox/aes_sbox_lut_freyre_1.v
    - rtl/AES_common/Sbox/aes_sbox_lut_freyre_2.v
    - rtl/AES_common/Sbox/aes_sbox_lut_freyre_3.v
    - rtl/AES_common/Sbox/aes_sbox_lut_hussain_6.v
    - rtl/AES_common/Sbox/aes_sbox_lut_ozkaynak_1.v
    - rtl/AES_common/Sbox/aes_sbox_lut_azam_1.v
    - rtl/AES_common/Sbox/aes_sbox_lut_azam_2.v
    - rtl/AES_common/Sbox/aes_sbox_lut_azam_3.v
    file_type: verilogSource

  rtl-single-round:
    files:
    - rtl/AES_single_round/aes_core.v
    file_type: verilogSource

  rtl-pipeline:
    files:
    - rtl/AES_pipeline/aes_pipeline_top.v
    - rtl/AES_pipeline/aes_round.v
    file_type: verilogSource
  
  rtl-fpga-common:
    files:
    - fpga/cdc_pulse.v
    - fpga/clocks.v
    - fpga/cw305_usb_reg_fe.v
    file_type: verilogSource

  rtl-fpga-aes:
    files:
    - fpga/cw305_aes_defines.v 
    - fpga/cw305_reg_aes.v
    - fpga/cw305_top.v
    file_type: verilogSource
  
  xdc-fpga-cw305:
    files:
    - fpga/cw305.xdc
    file_type: xdc
  
targets:
  default: &default
    filesets:
    - rtl-bare
    - "!AES_pipeline ? (rtl-single-round)"
    - AES_pipeline ? (rtl-pipeline)

  # AES FPGA synthesis on CW305 board
  cw305-aes:
    <<: *default
    default_tool: vivado
    filesets_append:
    - rtl-fpga-common
    - rtl-fpga-aes
    - xdc-fpga-cw305
    tools:
      vivado:
        part: xc7a100tftg256-2
    toplevel: [cw305_top]


