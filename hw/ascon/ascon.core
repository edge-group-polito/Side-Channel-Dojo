#
# File: ascon.core
# Author: Mattia Mirigaldi
# Date: 06/06/2024
# Description: ASCON implementation HDL files

name: "vlsi:polito:ascon:0.1.0"
description: "ascon HDL autogenerated with ASIP tool"

filesets:
  ascon-asip-vhdl:
    files:
    - ASCON_asip/ascon_globals.vhd
    - ASCON_asip/ascon_datapath.vhd
    - ASCON_asip/ascon_round_constants_gen.vhd 
    - ASCON_asip/ascon_round.vhd
    - ASCON_asip/ascon.vhd
    file_type: vhdlSource    

  ascon-asip-sv:
    files:
    - ASCON_asip/ascon_cu.sv
    file_type: systemVerilogSource   
  
  ascon-init-rtl:
    files:
    - ascon_common/Sbox/sbox_ascon.v
    - ascon_common/Sbox/sbox_allouzi.v
    - ascon_common/Sbox/sbox_bilgin.v
    - ascon_common/Sbox/sbox_lu_4.v
    - ascon_common/Sbox/sbox_lu_5.v
    - ascon_common/Sbox/sbox_lu_6.v
    - ascon_common/Sbox/sbox_lu_7.v
    - ASCON_init/primitives.v
    - ASCON_init/reg_S.v
    - ASCON_init/ascon_init.v
    file_type: verilogSource
    
targets:
  default:
    filesets:
    - asip_impl ? (ascon-asip-vhdl)
    - asip_impl ? (ascon-asip-sv)
    - "!asip_impl ? (ascon-init-rtl)"
