#
# File: aes_scr.core
# Author: Mattia Mirigaldi
# Date: 06/06/2024
# Description: AES side channel resistant implementation top-level core file

name: "polito:aes_scr:aes_scr:0.1.0"
description: "AES implentation resistant to side channel attacks"

filesets: 
  rtl-bare:
    files:
    - hw/AES_scr/aes_ks.v
    - hw/AES_scr/aes_sbox.v
    - hw/AES_scr/aes_sbox_lut_rijandael.v
    - hw/AES_scr/aes_sbox_lut_freyre_1.v
    - hw/AES_scr/aes_sbox_lut_freyre_2.v
    - hw/AES_scr/aes_sbox_lut_freyre_3.v
    - hw/AES_scr/aes_sbox_lut_hussain_6.v
    - hw/AES_scr/aes_sbox_lut_ozkaynak_1.v
    - hw/AES_scr/aes_core.v
    file_type: verilogSource

  questasim-bare-tb:
    files:
    - tb/modelsim/clock_gen.v
    - tb/modelsim/tb_aes.v
    file_type: verilogSource

  verilator-bare-tb:
    files:
    - tb/verilator/common/tb_macros.cpp    
    - tb/verilator/common/tb_macros.hh: {is_include_file: true}
    - tb/verilator/tb_components.cpp
    - tb/verilator/tb_components.hh: {is_include_file: true}
    - tb/verilator/aes_scr_tb.cpp
    file_type: cppSource

  verilator-waivers:
    files:
    - tb/verilator/misc/tb-waivers.vlt
    file_type: vlt

  rtl-fpga:
    files:
    - hw/fpga/cdc_pulse.v
    - hw/fpga/clocks.v
    - hw/fpga/cw305_aes_defines.v 
    - hw/fpga/cw305_reg_aes.v
    - hw/fpga/cw305_usb_reg_fe.v
    - hw/fpga/cw305_top.v
    file_type: verilogSource
  
  xdc-fpga-cw305:
    files:
    - hw/fpga/cw305.xdc
    file_type: xdc

scripts:
  # Create log directory
  prepare_dirs:
    cmd:
    - mkdir
    - -p
    - logs
  
  # Copy simulation logs and waveforms in common directory
  copy_logs:
    cmd:
    - bash
    - ../../../scripts/sim/copy-logs.sh
    - logs/waves.fst

targets:
  # Default target
  default: &default
    filesets:
    - rtl-bare
    - tool_verilator ? (verilator-waivers)
    toplevel: aes_core
   
   # RTL simulation
  sim: 
    <<: *default
    default_tool: modelsim
    filesets_append: 
    - tool_modelsim ? (questasim-bare-tb)
    - tool_verilator ? (verilator-bare-tb)
    toplevel:
    - tool_verilator ? (aes_core)      
    - "!tool_verilator ? (tb_aes)"
    parameters:
    - tool_verilator ? (log_level)
    - tool_verilator ? (max_cycles)
    - tool_verilator ? (dump_trace)
    - tool_verilator ? (dump_waves)
    hooks:
      pre_run:
      - prepare_dirs
      post_run:
      - copy_logs
    tools:
      modelsim:
        vlog_options:
        - -override_timescale 1ns/1ps
        - -pedanticerrors
      verilator:
        mode: cc
        verilator_options:
        - '--cc'
        - '--assert'
        - '--trace'
        - '--trace-fst'
        - '--trace-structs'
        - '--trace-max-array 128'
        - '--x-assign unique'
        - '--x-initial unique'
        - '--report-unoptflat'
        - '--exe'
        - 'aes_scr_tb.cpp'
        - '-Wall'
        - '-Wpedantic'

  # FPGA synthesis
  cw305:
    <<: *default
    default_tool: vivado
    filesets_append:
    - rtl-fpga
    - xdc-fpga-cw305
    parameters:
    - GOOGLE_VAULT_AES=true
    tools:
      vivado:
        part: xc7a100tftg256-2
    toplevel: [cw305_top]

  # Format HDL with Verible
  format:
    filesets: 
    - rtl-bare
    - questasim-bare-tb
    - rtl-fpga
    toplevel: aes_core
    description: Format source files using verible-verilog-format
    default_tool: veribleformat
    tools:
      veribleformat:
        verible_format_args:
        - '--assignment_statement_alignment=align'
        - '--case_items_alignment=align'
        - '--formal_parameters_indentation=indent'
        - '--named_parameter_alignment=align'
        - '--named_parameter_indentation=indent'
        - '--named_port_alignment=align'
        - '--named_port_indentation=indent'
        - '--port_declarations_alignment=align'
        - '--port_declarations_indentation=indent'
        - '--assignment_statement_alignment=align'
        - '--module_net_variable_alignment=align'
        - '--inplace'

  # Static analysis with Verible
  lint:
    filesets:
    - rtl-bare
    - questasim-bare-tb
    - rtl-fpga
    toplevel: aes_core
    description: Perform static analysis using Verible
    default_tool: veriblelint
    tools:
      veriblelint:
        ruleset: default
        rules:
        - 'line-length=length:140'

# Parameters
parameters:
  log_level:
    datatype: str
    description: |
      Set the log level. Admitted values: LOG_NONE|LOG_LOW|LOG_MEDIUM|LOG_HIGH|LOG_FULL|LOG_DEBUG.
      Errors and configuration messages are always printed.
    paramtype: cmdlinearg
  dump_waves:
    datatype: str
    description: If 'true', dump waveforms
    default: "true"
    paramtype: cmdlinearg
  dump_trace:
    datatype: str
    description: If 'true', generate instruction execution trace
    default: "false"
    paramtype: cmdlinearg
  max_cycles:
    datatype: int
    description: Maximum number of simulation cycles (halt the simulation when reached).
    paramtype: cmdlinearg
  GOOGLE_VAULT_AES:
    datatype: bool
    paramtype: vlogdefine
    default: true